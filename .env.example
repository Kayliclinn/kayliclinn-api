# Copier ce fichier vers .env.local puis renseigner les vraies valeurs.
# NE JAMAIS commiter de fichier .env (ignoré par .gitignore).

# ─── Stripe (obligatoire) ───
# Dashboard Stripe → Développeurs → Clés API
STRIPE_SECRET_KEY=sk_test_<votre_cle_secrete>
# Dashboard Stripe → Développeurs → Webhooks → votre endpoint → "Signing secret"
# En local : valeur whsec_... affichée par `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_<votre_secret_de_signature>

# ─── Site (optionnel) ───
# URL publique utilisée pour les redirections success_url / cancel_url.
# Défaut si absent : https://kayliclinn.fr
SITE_URL=https://kayliclinn.fr

# ─── Emails via Resend (optionnel) ───
# Si RESEND_API_KEY est absente, l'API fonctionne mais N'ENVOIE PAS d'emails.
RESEND_API_KEY=re_<votre_cle_resend>
# Adresse recevant la notification de nouvelle réservation.
# Défaut si absent : contact@kayliclinn.fr
NOTIFICATION_EMAIL=contact@kayliclinn.fr
